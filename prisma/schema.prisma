
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

// keeping the contact model and adding a notes relationship
model Contact {
  id          Int    @id @default(autoincrement())
  firstName   String
  lastName    String
  address     String
  image       String
  description String
  owner       String
  notes       Note[] // added so each contact can have multiple notes
}

// added this model to store notes for each contact
model Note {
  id        Int      @id @default(autoincrement())
  contactId Int
  note      String
  owner     String
  createdAt DateTime @default(now()) // automatically saves when the note was created

  // connects each note to its contact
  Contact   Contact  @relation(fields: [contactId], references: [id])
}
